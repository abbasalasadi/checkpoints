# Checkpoints configuration template. Copy to .env (laptop) and .env.vm (deploy VM).
# Real values live only in the git-ignored .env / .env.vm, backed up with `make secrets-push`.

APP_ENV=dev                      # dev | test | staging | production
API_PORT=8157                    # reserved by the manager (decisions D11)
WEB_PORT=5203                    # laptop only (decisions D11)
APP_BASE_URL=http://localhost:5203
DB_PATH=var/db/app.db
CONTENT_DIR=content
RUNNER_BACKEND=docker            # docker | cloudrun
RUNNER_CONCURRENCY=2
COOLDOWN_RUN_SEC=30
COOLDOWN_SUBMIT_SEC=90
REBOOT01_SIGNIN_URL=           # optional; the code default is the Reboot01 sign-in endpoint


# Secret: PrivateBox access token, write scope (this project uploads its backup).
# Read only by scripts/secrets-backup.sh; laptop .env only. Set by the owner; never printed or committed.
CHECKPOINTS_PRIVATEBOX_TOKEN=
