# Checkpoints configuration template. Copy to .env (laptop) and .env.vm (deploy VM).
# Real values live only in the git-ignored .env / .env.vm, backed up with `make secrets-push`.
# Every value here is a safe placeholder; empty means "use the code default".

# dev | test | staging | production
APP_ENV=dev
# reserved by the manager (decisions D11)
API_PORT=8157
# laptop only (decisions D11)
WEB_PORT=5203
# public origin, e.g. http://localhost:5203
APP_BASE_URL=
DB_PATH=var/db/app.db
CONTENT_DIR=content
# optional; the code default is the Reboot01 sign-in endpoint
REBOOT01_SIGNIN_URL=

# Runner. Limits are fixed by D15/D16; these only tune transport and images.
# docker | cloudrun (go and js only; rust is always docker)
RUNNER_BACKEND=docker
# comma list of backends checked at startup (empty = go,js,rust);
# outside production a missing image only warns
RUNNER_LANGUAGES=
RUNNER_CONCURRENCY=3
COOLDOWN_RUN_SEC=30
COOLDOWN_SUBMIT_SEC=90
# images (empty = code defaults)
RUNNER_IMAGE=
RUNNER_GO_IMAGE=
RUNNER_JS_IMAGE=
# Cloud Run service URLs (RUNNER_BACKEND=cloudrun)
RUNNER_GO_CLOUDRUN_URL=
RUNNER_JS_CLOUDRUN_URL=
# host dir for per-run bind mounts
RUNNER_RUNS_DIR=var/runs
RUNNER_TMPFS_MB=64
RUNNER_QUEUE_MAX=40
RUNNER_OUTPUT_LIMIT_KB=1024

# Deploy (.env.vm / deploy environment)
VM_HOST=
VM_USER=
VM_SSH_PORT=
VM_SSH_KEY=
# overrides VM_USER@VM_HOST when set
DEPLOY_SSH_TARGET=
VM_DOMAIN=
REMOTE_PROJECT_DIR=
REMOTE_SYSTEMD_SERVICE=
REMOTE_ENV_FILE=
REMOTE_MAINTENANCE_FLAG=
REMOTE_MAINTENANCE_HTML=
CERTBOT_EMAIL=
# backend bind address on the VM
SERVER_HOST=127.0.0.1
# legacy per-language nginx sites; see scripts/deploy/nginx-setup.sh
LEGACY_DISABLE=0
BACKUP_DIR=
BACKUP_KEEP=14

# Secret: PrivateBox access token, write scope (this project uploads its backup).
# Read only by scripts/secrets-backup.sh; laptop .env only. Set by the owner; never printed or committed.
CHECKPOINTS_PRIVATEBOX_TOKEN=
